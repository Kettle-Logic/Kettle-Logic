# Build output. Everything under build/ is generated: the engine and app builds, the release files, the
# smoke-test screenshots, and the logs. Other build folders from the README steps and the Flatpak builder are listed too.
build/
build-flatpak/
build-repo/
.flatpak-builder/
dist/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/

